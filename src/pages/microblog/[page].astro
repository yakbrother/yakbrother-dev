---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Layout from '../../layouts/Layout.astro';
import LinkCard from '../../components/LinkCard.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allMicroblog = await getCollection('microblog');
  
  const microblog = allMicroblog
    .filter(post => post.data.public)
    .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());

  const pages = paginate(microblog, { pageSize: 40 });
  
  return pages;
}

const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? 'Microblog' : `Microblog - Page ${page.currentPage}`;
---

<Layout title={pageTitle}>
  <div class="page-content flow">
    <Breadcrumbs path={['Microblog']} />
    <h1>Microblog</h1>
    <p class="subtitle">Quick links, finds, and micro-thoughts from around the web.</p>
    <hr/>
    
    <div class="microblog-grid">
      {page.data.map((post) => (
        <LinkCard
          type={post.data.type}
          title={post.data.title}
          description={post.data.description}
          link={post.data.link}
          publicationDate={post.data.publicationDate}
        />
      ))}
    </div>

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl="/microblog/"
    />
  </div>
</Layout>

<style>
  .microblog-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    color: var(--color-dark);
    width: 50%;
  }

  .subtitle {
    margin: 0 0 2rem;
    font-size: var(--step-0);
    color: var(--color-text-muted);
  }

  .microblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

</style>
